{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consigliere-ar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // Serve the built React SPA and route /api/* + /agents/* to the Worker
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },

  // Cloudflare Workers AI — open-source models with zero external API keys
  "ai": {
    "binding": "AI"
  },

  // Cloudflare Agents SDK (Stateful Durable Objects with isolated SQLite + Alarms + WebSockets)
  "durable_objects": {
    "bindings": [
      {
        "name": "DebtorAgent",
        "class_name": "DebtorAgent"
      },
      {
        "name": "PortfolioHub",
        "class_name": "PortfolioHub"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DebtorAgent", "PortfolioHub"]
    }
  ]
}
